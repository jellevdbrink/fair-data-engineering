                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Primary factors"@en .


###  https://w3id.org/FAIR-course-UT/2026/group10/ont#bus
:bus rdf:type owl:NamedIndividual ,
              :CollisionType ;
     <http://www.w3.org/2004/02/skos/core#definition> "A crash involving a bus."@en ;
     <http://www.w3.org/2004/02/skos/core#inScheme> :CollisionTypeScheme ;
     <http://www.w3.org/2004/02/skos/core#notation> "Bus" ;
     <http://www.w3.org/2004/02/skos/core#prefLabel> "bus"@en ;
     <http://www.w3.org/2004/02/skos/core#topConceptOf> :CollisionTypeScheme .


###  https://w3id.org/FAIR-course-UT/2026/group10/ont#cyclist
:cyclist rdf:type owl:NamedIndividual ,
                  :CollisionType ;
         <http://www.w3.org/2004/02/skos/core#definition> "A crash involving a cyclist."@en ;
         <http://www.w3.org/2004/02/skos/core#inScheme> :CollisionTypeScheme ;
         <http://www.w3.org/2004/02/skos/core#notation> "Cyclist" ;
