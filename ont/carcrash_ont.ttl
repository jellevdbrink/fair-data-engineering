###  https://w3id.org/FAIR-course-UT/2026/group10/ont#disregard-signal
:disregard-signal rdf:type owl:NamedIndividual ,
                           :PrimaryFactor ;
                  <http://www.w3.org/2004/02/skos/core#definition> "A driver ignored a traffic signal or a regulatory sign, such as a stop sign."@en ;
                  <http://www.w3.org/2004/02/skos/core#inScheme> :PrimaryFactorScheme ;
                  <http://www.w3.org/2004/02/skos/core#notation> "DISREGARD SIGNAL/REG SIGN" ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "disregarded signal or regulatory sign"@en ;
                  <http://www.w3.org/2004/02/skos/core#topConceptOf> :PrimaryFactorScheme .


###  https://w3id.org/FAIR-course-UT/2026/group10/ont#failure-to-yield
:failure-to-yield rdf:type owl:NamedIndividual ,
                           :PrimaryFactor ;
                  <http://www.w3.org/2004/02/skos/core#definition> "A driver did not give way to a road user who had the right of way."@en ;
                  <http://www.w3.org/2004/02/skos/core#inScheme> :PrimaryFactorScheme ;
                  <http://www.w3.org/2004/02/skos/core#notation> "FAILURE TO YIELD RIGHT OF WAY" ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "failure to yield right of way"@en ;
                  <http://www.w3.org/2004/02/skos/core#topConceptOf> :PrimaryFactorScheme .


###  https://w3id.org/FAIR-course-UT/2026/group10/ont#fatal
:fatal rdf:type owl:NamedIndividual ,
                :InjuryType ;
       <http://www.w3.org/2004/02/skos/core#definition> "At least one person died as a result of the crash."@en ;
       <http://www.w3.org/2004/02/skos/core#inScheme> :InjuryTypeScheme ;
       <http://www.w3.org/2004/02/skos/core#notation> "Fatal" ;
       <http://www.w3.org/2004/02/skos/core#prefLabel> "fatal"@en ;
       <http://www.w3.org/2004/02/skos/core#topConceptOf> :InjuryTypeScheme .


###  https://w3id.org/FAIR-course-UT/2026/group10/ont#following-too-closely
:following-too-closely rdf:type owl:NamedIndividual ,
                                :PrimaryFactor ;
                       <http://www.w3.org/2004/02/skos/core#definition> "A driver followed another vehicle too closely to stop in time."@en ;
                       <http://www.w3.org/2004/02/skos/core#inScheme> :PrimaryFactorScheme ;
                       <http://www.w3.org/2004/02/skos/core#notation> "FOLLOWING TOO CLOSELY" ;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "following too closely"@en ;
                       <http://www.w3.org/2004/02/skos/core#topConceptOf> :PrimaryFactorScheme .


###  https://w3id.org/FAIR-course-UT/2026/group10/ont#incapacitating
:incapacitating rdf:type owl:NamedIndividual ,
                         :InjuryType ;
                <http://www.w3.org/2004/02/skos/core#definition> "At least one person was injured badly enough to be unable to walk, drive or carry on normal activities."@en ;
                <http://www.w3.org/2004/02/skos/core#inScheme> :InjuryTypeScheme ;
                <http://www.w3.org/2004/02/skos/core#notation> "Incapacitating" ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "incapacitating injury"@en ;
                <http://www.w3.org/2004/02/skos/core#topConceptOf> :InjuryTypeScheme .


###  https://w3id.org/FAIR-course-UT/2026/group10/ont#moped-motorcycle
:moped-motorcycle rdf:type owl:NamedIndividual ,
                           :CollisionType ;
                  <http://www.w3.org/2004/02/skos/core#definition> "A crash involving a moped or a motorcycle."@en ;
                  <http://www.w3.org/2004/02/skos/core#inScheme> :CollisionTypeScheme ;
                  <http://www.w3.org/2004/02/skos/core#notation> "Moped/Motorcycle" ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "moped or motorcycle"@en ;
                  <http://www.w3.org/2004/02/skos/core#topConceptOf> :CollisionTypeScheme .


###  https://w3id.org/FAIR-course-UT/2026/group10/ont#no-injury-or-unknown
:no-injury-or-unknown rdf:type owl:NamedIndividual ,
                               :InjuryType ;
                      <http://www.w3.org/2004/02/skos/core#definition> "Nobody was injured in the crash, or whether anybody was injured is not known."@en ;
                      <http://www.w3.org/2004/02/skos/core#inScheme> :InjuryTypeScheme ;
                      <http://www.w3.org/2004/02/skos/core#notation> "No injury/unknown" ;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "no injury or unknown"@en ;
                      <http://www.w3.org/2004/02/skos/core#topConceptOf> :InjuryTypeScheme .


###  https://w3id.org/FAIR-course-UT/2026/group10/ont#non-incapacitating
:non-incapacitating rdf:type owl:NamedIndividual ,
                             :InjuryType ;
                    <http://www.w3.org/2004/02/skos/core#definition> "At least one person was injured, but no injury prevented the person from walking, driving or carrying on normal activities."@en ;
                    <http://www.w3.org/2004/02/skos/core#inScheme> :InjuryTypeScheme ;
                    <http://www.w3.org/2004/02/skos/core#notation> "Non-incapacitating" ;
