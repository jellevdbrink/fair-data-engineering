#    Classes
#################################################################

###  http://schema.org/Event
<http://schema.org/Event> rdf:type owl:Class .


###  http://www.w3.org/2004/02/skos/core#Concept
<http://www.w3.org/2004/02/skos/core#Concept> rdf:type owl:Class .


###  http://www.w3.org/2004/02/skos/core#ConceptScheme
<http://www.w3.org/2004/02/skos/core#ConceptScheme> rdf:type owl:Class .


###  https://w3id.org/FAIR-course-UT/2026/group10/ont#CollisionType
:CollisionType rdf:type owl:Class ;
               rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
               rdfs:isDefinedBy <https://w3id.org/FAIR-course-UT/2026/group10/ont> ;
               rdfs:label "Collision type"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "A category describing which, and how many, road users were involved in a crash."@en .


###  https://w3id.org/FAIR-course-UT/2026/group10/ont#Crash
:Crash rdf:type owl:Class ;
       rdfs:subClassOf <http://schema.org/Event> ;
       rdfs:isDefinedBy <https://w3id.org/FAIR-course-UT/2026/group10/ont> ;
       rdfs:label "Crash"@en ;
       <http://www.w3.org/2004/02/skos/core#definition> "A road traffic crash recorded in the Monroe County (Indiana) crash reports. Its time is given with time:hasTime and its place with schema:location."@en .


###  https://w3id.org/FAIR-course-UT/2026/group10/ont#InjuryType
:InjuryType rdf:type owl:Class ;
            rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
            rdfs:isDefinedBy <https://w3id.org/FAIR-course-UT/2026/group10/ont> ;
            rdfs:label "Injury type"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "A category describing the most severe injury resulting from a crash."@en .


###  https://w3id.org/FAIR-course-UT/2026/group10/ont#PrimaryFactor
:PrimaryFactor rdf:type owl:Class ;
               rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
               rdfs:isDefinedBy <https://w3id.org/FAIR-course-UT/2026/group10/ont> ;
               rdfs:label "Primary factor"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "A category describing the main contributing cause of a crash, as recorded in the crash report."@en .


