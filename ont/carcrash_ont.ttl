#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/FAIR-course-UT/2026/group10/ont#collisionType
:collisionType rdf:type owl:ObjectProperty ;
               rdfs:domain :Crash ;
               rdfs:range :CollisionType ;
               rdfs:isDefinedBy <https://w3id.org/FAIR-course-UT/2026/group10/ont> ;
               rdfs:label "collision type"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "Relates a crash to its collision type."@en .


###  https://w3id.org/FAIR-course-UT/2026/group10/ont#injuryType
:injuryType rdf:type owl:ObjectProperty ;
            rdfs:domain :Crash ;
            rdfs:range :InjuryType ;
            rdfs:isDefinedBy <https://w3id.org/FAIR-course-UT/2026/group10/ont> ;
            rdfs:label "injury type"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates a crash to the most severe injury it caused."@en .


###  https://w3id.org/FAIR-course-UT/2026/group10/ont#primaryFactor
:primaryFactor rdf:type owl:ObjectProperty ;
               rdfs:domain :Crash ;
               rdfs:range :PrimaryFactor ;
               rdfs:isDefinedBy <https://w3id.org/FAIR-course-UT/2026/group10/ont> ;
               rdfs:label "primary factor"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "Relates a crash to its main contributing cause."@en .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/FAIR-course-UT/2026/group10/ont#isWeekend
:isWeekend rdf:type owl:DatatypeProperty ;
           rdfs:domain :Crash ;
           rdfs:range xsd:boolean ;
           rdfs:isDefinedBy <https://w3id.org/FAIR-course-UT/2026/group10/ont> ;
           rdfs:label "is weekend"@en ;
           <http://www.w3.org/2004/02/skos/core#definition> "True if the crash happened on a Saturday or Sunday, false if it happened on a weekday."@en .


